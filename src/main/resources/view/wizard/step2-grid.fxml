<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.wizard.Step2GridController">

  <top>
    <VBox spacing="8" styleClass="step-header">
      <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>
      <Label text="Paso 2: Detectar grilla" styleClass="step-title"/>
      <Label text="Verificá que la grilla se alinee con los cuadros dibujados"
             styleClass="step-subtitle"/>
    </VBox>
  </top>

  <center>
    <HBox spacing="15" alignment="TOP_LEFT" maxHeight="Infinity">
      <padding><Insets top="15" right="24" bottom="15" left="24"/></padding>

      <StackPane fx:id="previewContainer" HBox.hgrow="ALWAYS"
                 minWidth="400" minHeight="300"
                 styleClass="preview-pane">
        <Canvas fx:id="previewCanvas"/>
      </StackPane>

      <ScrollPane fitToWidth="true" styleClass="controls-panel"
                  prefWidth="280">
        <VBox spacing="15">
          <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

          <Label text="Configuración" styleClass="section-title"/>

          <VBox spacing="4">
            <Label text="Preset de grilla"/>
            <ComboBox fx:id="presetCombo" maxWidth="Infinity"/>
          </VBox>

          <VBox spacing="4">
            <Label text="Orientación"/>
            <HBox spacing="8">
              <ToggleButton fx:id="portraitToggle" text="Vertical">
                <toggleGroup>
                  <ToggleGroup fx:id="orientationGroup"/>
                </toggleGroup>
              </ToggleButton>
              <ToggleButton fx:id="landscapeToggle" text="Horizontal"
                            selected="true">
                <toggleGroup>
                  <fx:reference source="orientationGroup"/>
                </toggleGroup>
              </ToggleButton>
            </HBox>
          </VBox>

          <VBox spacing="4">
            <Label fx:id="marginLabel" text="Margen: 15 mm"/>
            <Slider fx:id="marginSlider" min="5" max="30" value="15"
                    blockIncrement="1"/>
          </VBox>

          <CheckBox fx:id="guideDotCheck" text="Incluir punto guía"
                    selected="true"/>

          <Button fx:id="detectButton" text="🔍 Detectar automáticamente"
                  maxWidth="Infinity" styleClass="button-primary"/>

          <Label fx:id="statusLabel" text="" wrapText="true"
                 styleClass="status-label"/>
        </VBox>
      </ScrollPane>
    </HBox>
  </center>

</BorderPane>
