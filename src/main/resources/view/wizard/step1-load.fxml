<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.wizard.Step1LoadController">

    <top>
        <VBox spacing="8" styleClass="step-header">
            <padding><Insets top="20" right="30" bottom="10" left="30"/></padding>
            <Label text="Paso 1: Cargar imagen" styleClass="step-title"/>
            <Label text="Arrastrá tu hoja A4 escaneada o elegí un archivo"
                   styleClass="step-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="dropZone" styleClass="drop-zone">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <VBox alignment="CENTER" spacing="10">
                <Label fx:id="dropLabel"
                       text="📁 Arrastrá tu imagen acá&#10;o usá el botón de abajo"
                       styleClass="drop-label"/>
                <ImageView fx:id="previewImage"
                           preserveRatio="true"
                           fitWidth="400"
                           fitHeight="500"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding><Insets top="10" right="30" bottom="20" left="30"/></padding>
            <Label fx:id="fileInfoLabel" text="" styleClass="file-info"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="chooseButton" text="Elegir archivo…" styleClass="button-outlined"/>
                <Button fx:id="nextButton" text="Siguiente →" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
