<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.wizard.Step1LoadController">

  <top>
    <VBox spacing="8" styleClass="step-header">
      <padding><Insets top="20" right="30" bottom="10" left="30"/></padding>
      <Label text="Paso 1: Cargar hojas" styleClass="step-title"/>
      <Label text="Agregá una o varias hojas escaneadas. Sus frames se unen en una sola animación, en el orden de la lista."
             styleClass="step-subtitle" wrapText="true"/>
    </VBox>
  </top>

  <center>
    <HBox spacing="15">
      <padding><Insets top="15" right="30" bottom="10" left="30"/></padding>

      <!-- Lista de hojas -->
      <VBox spacing="8" prefWidth="330" minWidth="280">
        <Label text="Hojas (orden de la animación)" styleClass="section-title"/>
        <ListView fx:id="sheetList" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8">
          <Button fx:id="addButton" text="＋ Agregar…" styleClass="button-outlined"/>
          <Button fx:id="upButton" text="▲" styleClass="button-outlined"/>
          <Button fx:id="downButton" text="▼" styleClass="button-outlined"/>
          <Button fx:id="removeButton" text="🗑 Quitar" styleClass="button-outlined"/>
        </HBox>
      </VBox>

      <!-- Zona de arrastre / vista previa -->
      <StackPane fx:id="dropZone" styleClass="drop-zone" HBox.hgrow="ALWAYS"
                 minWidth="200">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <VBox alignment="CENTER" spacing="10">
          <Label fx:id="dropLabel"
                 text="Arrastrá tus imágenes acá&#10;(podés soltar varias a la vez)"
                 styleClass="drop-label"
                 wrapText="true"
                 textAlignment="CENTER"
                 maxWidth="400"/>
          <ImageView fx:id="previewImage" preserveRatio="true"
                     fitWidth="380" fitHeight="400"/>
        </VBox>
      </StackPane>
    </HBox>
  </center>

  <bottom>
    <VBox spacing="10">
      <padding><Insets top="10" right="30" bottom="20" left="30"/></padding>
      <Label fx:id="fileInfoLabel" text="" styleClass="file-info"/>
      <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="nextButton" text="Siguiente →" styleClass="button-primary"/>
      </HBox>
    </VBox>
  </bottom>

</BorderPane>
