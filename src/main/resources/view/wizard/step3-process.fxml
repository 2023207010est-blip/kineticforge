<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.wizard.Step3ProcessController">

  <top>
    <VBox spacing="8" styleClass="step-header">
      <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>
      <Label text="Paso 3: Procesar frames" styleClass="step-title"/>
      <Label text="Extrae, quita el fondo y alinea cada frame automáticamente"
             styleClass="step-subtitle"/>
    </VBox>
  </top>

  <center>
    <ScrollPane fitToWidth="true" styleClass="preview-scroll">
      <StackPane fx:id="previewContainer" styleClass="preview-pane">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <GridPane fx:id="framesGrid" hgap="6" vgap="6"
                  alignment="CENTER"/>
      </StackPane>
    </ScrollPane>
  </center>

  <bottom>
    <VBox spacing="10" styleClass="process-controls">
      <padding><Insets top="12" right="24" bottom="16" left="24"/></padding>

      <Label fx:id="progressLabel" text="Presioná «Procesar» para comenzar."
             styleClass="file-info"/>

      <ProgressBar fx:id="progressBar" progress="0.0"
                   maxWidth="Infinity" prefHeight="8"/>

      <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="processButton" text="⚙ Procesar frames"
                styleClass="button-primary"/>
        <Button fx:id="nextButton" text="Siguiente →"
                disable="true" styleClass="button-primary"/>
      </HBox>
    </VBox>
  </bottom>

</BorderPane>
