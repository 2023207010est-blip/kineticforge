<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootStack"
           fx:controller="io.kineticforge.ui.controller.wizard.WizardController">

  <BorderPane prefWidth="1100.0" prefHeight="750.0">

    <top>
      <HBox styleClass="header" spacing="10.0" alignment="CENTER_LEFT">
        <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
          <Label text="KineticForge" styleClass="title"/>
          <Label text="Convierte hojas A4 en animaciones con fondo transparente"
                 styleClass="subtitle"/>
        </VBox>
        <Button fx:id="bgToolButton" text="◐ Quitar fondo"
                onAction="#onOpenBgTool" styleClass="button-outlined"/>
        <Button fx:id="templatesButton" text="☰ Plantillas"
                onAction="#onOpenTemplates" styleClass="button-outlined"/>
        <Button fx:id="themeButton" text="☾ Oscuro"
                onAction="#onToggleTheme" styleClass="button-outlined"/>
      </HBox>
    </top>

    <center>
      <StackPane fx:id="contentArea" styleClass="wizard-content">
        <!-- Los pasos se cargan dinámicamente -->
      </StackPane>
    </center>

    <bottom>
      <VBox styleClass="wizard-nav">
        <padding><Insets top="12" right="24" bottom="16" left="24"/></padding>
        <HBox spacing="15" alignment="CENTER_LEFT">
          <Label fx:id="stepIndicator" text="Paso 1" styleClass="step-indicator"/>
          <HBox HBox.hgrow="ALWAYS"/>
          <Button fx:id="backButton" text="← Atrás"
                  onAction="#onBack" styleClass="button-outlined"/>
          <Button fx:id="nextButton" text="Siguiente →"
                  onAction="#onNext" styleClass="button-primary"/>
        </HBox>
      </VBox>
    </bottom>

  </BorderPane>
</StackPane>
