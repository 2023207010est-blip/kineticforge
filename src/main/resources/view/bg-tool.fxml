<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.BgToolController"
            prefWidth="1000.0" prefHeight="700.0">

  <top>
    <VBox styleClass="step-header" spacing="6.0">
      <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>
      <Label text="Borrar fondo blanco" styleClass="step-title"/>
      <Label text="Cargá una imagen y borrá TODOS los píxeles blancos"
             styleClass="step-subtitle"/>
    </VBox>
  </top>

  <center>
    <HBox spacing="15" alignment="TOP_LEFT" maxHeight="Infinity">
      <padding><Insets top="15" right="24" bottom="15" left="24"/></padding>

      <StackPane fx:id="previewContainer" HBox.hgrow="ALWAYS"
                 minWidth="500" minHeight="400"
                 styleClass="preview-pane"
                 style="-fx-background-color: white;">
        <ImageView fx:id="previewImage" preserveRatio="true" smooth="true"/>
      </StackPane>

      <VBox spacing="12" styleClass="controls-panel" prefWidth="280">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <Label text="Configuración" styleClass="section-title"/>

        <Button fx:id="loadButton" text="📂 Cargar imagen"
                maxWidth="Infinity" styleClass="button-outlined"/>

        <VBox spacing="4">
          <Label fx:id="thresholdLabel" text="Tolerancia: 240"/>
          <Slider fx:id="thresholdSlider"
                  min="200" max="255" value="240"
                  showTickMarks="true" showTickLabels="true"
                  majorTickUnit="10" minorTickCount="4"/>
          <Label text="↑ Baja tolerancia = borra menos&#10;↓ Alta tolerancia = borra más"
                 styleClass="file-info" wrapText="true"/>
        </VBox>

        <Button fx:id="processButton" text="🔥 Borrar blancos"
                maxWidth="Infinity" styleClass="button-primary"
                disable="true"/>

        <Label fx:id="statusLabel" text="" wrapText="true"
               styleClass="file-info"/>

        <Button fx:id="saveButton" text="💾 Guardar PNG"
                maxWidth="Infinity" styleClass="button-primary"
                disable="true"/>
      </VBox>
    </HBox>
  </center>

</BorderPane>
