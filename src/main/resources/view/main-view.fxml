<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.kineticforge.ui.controller.MainController"
            prefWidth="1024.0" prefHeight="720.0">
    <top>
        <VBox styleClass="header" spacing="4.0">
            <Label text="KineticForge" styleClass="title"/>
            <Label text="Convierte hojas A4 en GIF animados con fondo transparente" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding><Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/></padding>
            <Label text="Bienvenido a KineticForge"/>
            <Label text="(Wizard — por implementar)"/>
        </VBox>
    </center>
    <bottom>
        <VBox styleClass="status-bar">
            <Label text="Listo."/>
        </VBox>
    </bottom>
</BorderPane>
